# ShopSphere Review Service
# Copy to .env and fill in. This file is committed; .env never is.

NODE_ENV=development
PORT=5100

# The reviews database. The review service owns this data outright.
MONGODB_URI=

# The main ShopSphere API. Product lookups and caller identity are resolved
# here over REST, which is why this service holds no Postgres credential and
# no JWT secret of its own.
SHOPSPHERE_API_URL=https://shopsphere-store-api.vercel.app

# Origin allowed to call this service from a browser.
CORS_ORIGIN=http://localhost:3000
