# DECI.Project - Backend environment example (local development without Docker)
# Copy this file to backend/.env and adjust values for your machine.
# These are development placeholder values; never commit a real .env file.

NODE_ENV=development
PORT=5000

# --- Databases ---
DATABASE_URL=postgresql://deci:deci_local_password@localhost:5432/deci_project?schema=public
MONGODB_URI=mongodb://localhost:27017/deci_project
DATABASE_CONNECTION_REQUIRED=true

# --- CORS (frontend origin) ---
CORS_ORIGIN=http://localhost:3000

# --- JWT (secrets must be at least 32 characters each) ---
JWT_ACCESS_SECRET=replace_this_with_a_random_value_of_32_chars_or_more
JWT_REFRESH_SECRET=replace_this_with_a_different_random_value_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- SMTP (Mailpit recommended for local development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=DECI.Project <no-reply@deci-project.local>
# SMTP_USER=
# SMTP_PASSWORD=

# --- Seed data ---
SEED_DATABASE=true
SEED_ADMIN_EMAIL=admin@deci-project.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_EMAIL=customer@deci-project.local
SEED_CUSTOMER_PASSWORD=Customer123!
