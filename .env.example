# DECI.Project - Root environment example (Docker Compose)
# Copy this file to .env, then run: docker compose up --build
# These are development placeholder values. Replace the password and JWT
# secrets with your own strong values for any real deployment.
# Never commit a real .env file; only .env.example belongs in Git.

# --- PostgreSQL ---
POSTGRES_DB=deci_project
POSTGRES_USER=deci
POSTGRES_PASSWORD=replace_with_your_local_postgres_password
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_PORT=27017

# --- Mailpit (development email inbox) ---
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Application ports ---
BACKEND_PORT=5000
FRONTEND_PORT=3000

# --- JWT secrets (must be at least 32 characters each) ---
JWT_ACCESS_SECRET=replace_this_with_a_random_value_of_32_chars_or_more
JWT_REFRESH_SECRET=replace_this_with_a_different_random_value_32_chars

# --- Seed accounts (created by the idempotent seed script) ---
SEED_ADMIN_EMAIL=admin@deci-project.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_EMAIL=customer@deci-project.local
SEED_CUSTOMER_PASSWORD=Customer123!
