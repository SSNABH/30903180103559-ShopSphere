# ShopSphere scheduled jobs
# Copy to .env for local runs. This file is committed; .env never is.

# The same Supabase database the main application uses. The job connects
# directly rather than through the API, because it is maintenance work on the
# data and has no business going through a user-facing request path.
DATABASE_URL=

# Vercel sends this as a bearer token on scheduled invocations. Without it the
# endpoint would be a public button for deleting carts.
CRON_SECRET=
